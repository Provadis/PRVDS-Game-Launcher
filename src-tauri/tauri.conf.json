{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PRVDS Game Launcher",
  "version": "../package.json",
  "identifier": "de.prvds.gamelauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "PRVDS Game Launcher",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#0E0F12",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/PRVDS/GameLauncher/covers/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Game",
    "shortDescription": "Game Launcher für den Desktop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["German", "English"],
        "installMode": "currentUser"
      },
      "wix": {
        "language": ["de-DE", "en-US"]
      }
    }
  }
}
